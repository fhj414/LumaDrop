generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ShareTargetType {
  ALBUM
  PHOTO
}

enum ShareTheme {
  editorial
  minimal
  noir
}

enum PhotoCategory {
  person
  animal
  plant
  city
  landscape
  interior
  food
  other
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  phone           String?          @unique
  authProvider    String           @default("email")
  name            String?
  avatarUrl       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  albums          Album[]
  photos          Photo[]
  shares          Share[]
  downloadRecords DownloadRecord[]
}

model Album {
  id           String   @id @default(cuid())
  userId       String
  title        String
  description  String   @default("")
  coverPhotoId String?
  theme        ShareTheme @default(editorial)
  isPrivate    Boolean  @default(true)
  isDeleted    Boolean  @default(false)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coverPhoto   Photo?   @relation("AlbumCover", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  photos       Photo[]  @relation("AlbumPhotos")
  shares       Share[]

  @@index([userId, createdAt])
}

model Photo {
  id              String           @id @default(cuid())
  userId          String
  albumId         String?
  title           String
  objectKey       String
  url             String
  width           Int?
  height          Int?
  size            Int
  mimeType        String
  dominantColor   String?
  favorite        Boolean          @default(false)
  category        PhotoCategory    @default(other)
  tags            String[]         @default([])
  exif            Json?
  isDeleted       Boolean          @default(false)
  deletedAt       DateTime?
  uploadedAt      DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  album           Album?           @relation("AlbumPhotos", fields: [albumId], references: [id], onDelete: SetNull)
  coveredAlbums   Album[]          @relation("AlbumCover")
  shares          Share[]
  downloadRecords DownloadRecord[]

  @@index([userId, uploadedAt])
  @@index([albumId])
}

model Share {
  id            String          @id @default(cuid())
  userId        String
  albumId       String?
  photoId       String?
  targetType    ShareTargetType
  token         String          @unique
  title         String
  isPublic      Boolean         @default(false)
  passwordHash  String?
  allowDownload Boolean         @default(true)
  theme         ShareTheme      @default(editorial)
  expiresAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  album         Album?          @relation(fields: [albumId], references: [id], onDelete: Cascade)
  photo         Photo?          @relation(fields: [photoId], references: [id], onDelete: Cascade)
  downloads     DownloadRecord[]

  @@index([userId, createdAt])
  @@index([token])
}

model DownloadRecord {
  id        String   @id @default(cuid())
  userId    String?
  shareId   String?
  photoId   String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  share     Share?   @relation(fields: [shareId], references: [id], onDelete: SetNull)
  photo     Photo?   @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@index([shareId, createdAt])
  @@index([photoId, createdAt])
}

model VerificationCode {
  id        String   @id @default(cuid())
  channel   String
  target    String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([channel, target])
  @@index([expiresAt])
}
