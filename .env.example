DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lumadrop?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-long-random-secret"

# Optional S3 / Cloudflare R2 compatible storage
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Real SMS login via Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_PHONE=""

# Real email OTP login via Resend
RESEND_API_KEY=""
EMAIL_FROM="LumaDrop <onboarding@resend.dev>"

# AI via OpenRouter
OPENROUTER_API_KEY=""
# Optional (default: google/gemini-2.0-flash-lite)
OPENROUTER_MODEL="google/gemini-2.0-flash-lite"
# Optional (recommended for OpenRouter analytics / policy)
OPENROUTER_HTTP_REFERER="http://localhost:3000"
OPENROUTER_APP_TITLE="LumaDrop"

# Real WeChat QR login via WeChat Open Platform
WECHAT_OPEN_APP_ID=""
WECHAT_OPEN_APP_SECRET=""
WECHAT_REDIRECT_URI="https://your-domain.com/auth/wechat/callback"
